# Hugging Face access token — REQUIRED (the model is gated).
# Accept the terms on the model page, then create a token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# API key checked against the X-Api-Key request header.
# Leave empty to disable authentication (development mode).
API_KEY=

# Optional overrides
# MODEL_ID=CohereLabs/cohere-transcribe-03-2026
# DEVICE=cpu   # force CPU inference (default: auto — CUDA if available)
